{
  "name": "@lynx-crypto/kraken-api",
  "version": "1.1.2",
  "description": "TypeScript Kraken SPOT REST client + WebSocket v2 client (Spot market only).",
  "license": "MIT",
  "author": "Brett Blashko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-laboratory/kraken-api.git"
  },
  "homepage": "https://github.com/lynx-laboratory/kraken-api#readme",
  "bugs": {
    "url": "https://github.com/lynx-laboratory/kraken-api/issues"
  },
  "keywords": [
    "kraken",
    "kraken-api",
    "crypto",
    "spot",
    "rest",
    "websocket",
    "websocket-v2",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn clean && yarn test && yarn build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:check": "node ./scripts/build-check.mjs",
    "example": "yarn run build:check && tsx",
    "examples:spot:rest:account-data:connect-private": "yarn example ./examples/spot/rest/account-data/00-connect-private.ts",
    "examples:spot:rest:account-data:account-balance": "yarn example ./examples/spot/rest/account-data/01-account-balance.ts",
    "examples:spot:rest:account-data:trade-balance": "yarn example ./examples/spot/rest/account-data/02-trade-balance.ts",
    "examples:spot:rest:account-data:open-orders": "yarn example ./examples/spot/rest/account-data/03-open-orders.ts",
    "examples:spot:rest:account-data:trades-history": "yarn example ./examples/spot/rest/account-data/04-trades-history.ts",
    "examples:spot:rest:account-data:ledgers-info": "yarn example ./examples/spot/rest/account-data/05-ledgers-info.ts",
    "examples:spot:rest:market-data:connect": "yarn example ./examples/spot/rest/market-data/00-connect.ts",
    "examples:spot:rest:market-data:server-time": "yarn example ./examples/spot/rest/market-data/01-server-time.ts",
    "examples:spot:rest:market-data:system-status": "yarn example ./examples/spot/rest/market-data/02-system-status.ts",
    "examples:spot:rest:market-data:asset-info": "yarn example ./examples/spot/rest/market-data/03-asset-info.ts",
    "examples:spot:rest:market-data:tradable-asset-pairs": "yarn example ./examples/spot/rest/market-data/04-tradable-asset-pairs.ts",
    "examples:spot:rest:market-data:ticker": "yarn example ./examples/spot/rest/market-data/05-ticker.ts",
    "examples:spot:rest:market-data:ohlc": "yarn example ./examples/spot/rest/market-data/06-ohlc.ts",
    "examples:spot:rest:market-data:order-book": "yarn example ./examples/spot/rest/market-data/07-order-book.ts",
    "examples:spot:rest:market-data:recent-trades": "yarn example ./examples/spot/rest/market-data/08-recent-trades.ts",
    "examples:spot:rest:market-data:recent-spreads": "yarn example ./examples/spot/rest/market-data/09-recent-spreads.ts",
    "examples:spot:rest:trading:websockets-token": "yarn example ./examples/spot/rest/trading/01-websockets-token.ts",
    "examples:spot:websocket-v2:admin:status": "yarn example ./examples/spot/websocket-v2/admin/01-status.ts",
    "examples:spot:websocket-v2:admin:heartbeat": "yarn example ./examples/spot/websocket-v2/admin/02-heartbeat.ts",
    "examples:spot:websocket-v2:admin:ping": "yarn example ./examples/spot/websocket-v2/admin/03-ping.ts",
    "examples:spot:websocket-v2:market-data:trades": "yarn example ./examples/spot/websocket-v2/market-data/01-trades.ts",
    "examples:spot:websocket-v2:market-data:ticker": "yarn example ./examples/spot/websocket-v2/market-data/02-ticker.ts",
    "examples:spot:websocket-v2:market-data:ohlc": "yarn example ./examples/spot/websocket-v2/market-data/03-ohlc.ts",
    "examples:spot:websocket-v2:market-data:book": "yarn example ./examples/spot/websocket-v2/market-data/04-book.ts",
    "examples:spot:websocket-v2:market-data:instruments": "yarn example ./examples/spot/websocket-v2/market-data/05-instruments.ts",
    "examples:spot:websocket-v2:user-data:balances": "yarn example ./examples/spot/websocket-v2/user-data/01-balances.ts",
    "examples:spot:websocket-v2:user-data:executions": "yarn example ./examples/spot/websocket-v2/user-data/02-executions.ts",
    "examples:bulk:ohlcvt:download": "yarn example ./examples/bulk/ohlcvt/01-download.ts",
    "examples:bulk:ohlcvt:extract": "yarn example ./examples/bulk/ohlcvt/02-extract.ts",
    "examples:bulk:ohlcvt:has": "yarn example ./examples/bulk/ohlcvt/03-has.ts",
    "examples:bulk:ohlcvt:list-intervals": "yarn example ./examples/bulk/ohlcvt/04-list-intervals.ts",
    "examples:bulk:ohlcvt:list-pairs": "yarn example ./examples/bulk/ohlcvt/05-list-pairs.ts",
    "examples:bulk:ohlcvt:query": "yarn example ./examples/bulk/ohlcvt/06-query.ts",
    "examples:bulk:trades:download": "yarn example ./examples/bulk/trades/01-download.ts",
    "examples:bulk:trades:extract": "yarn example ./examples/bulk/trades/02-extract.ts",
    "examples:bulk:trades:has": "yarn example ./examples/bulk/trades/03-has.ts",
    "examples:bulk:trades:list-pairs": "yarn example ./examples/bulk/trades/04-list-pairs.ts",
    "examples:bulk:trades:query": "yarn example ./examples/bulk/trades/05-query.ts"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "googleapis": "^169.0.0",
    "ws": "^8.18.3",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3",
    "@vitest/coverage-v8": "4.0.15",
    "dotenv": "^17.2.3",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "yazl": "^3.3.1"
  }
}
